# Dependencies
node_modules/

# Next.js build output
.next/
out/
dist/
build/
dashboard/next-env.d.ts

# Local caches and generated dashboard results. Ignore everything nested, then
# re-include only the small files the app needs: JSON, plus the labels matrix and
# config map parquet the animation reads directly (keeps large parquet out of git).
cached_results/**
!cached_results/.gitkeep
!cached_results/**/
!cached_results/**/*.json
!cached_results/**/labels.parquet
!cached_results/**/configs.parquet
.turbo/
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env*.local

# Python/runtime artifacts
__pycache__/
*.py[cod]
*.tsbuildinfo
.pytest_cache/
.ipynb_checkpoints/

# Build cache contains a mix of generated outputs and source notebooks/scripts.
build_cache/**
!build_cache/.gitkeep
!build_cache/**/
!build_cache/**/*.py
!build_cache/**/*.ipynb

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
